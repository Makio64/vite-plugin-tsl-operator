{
  "name": "vite-plugin-tsl-operator",
  "version": "1.10.0",
  "description": "Use standard JavaScript operators inside Three.js TSL Fn() blocks with Vite.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "build": "mkdir -p dist && cp src/index.js dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser"
  },
  "keywords": [
    "tsl",
    "three",
    "three.js",
    "threejs",
    "three-tsl",
    "webgpu",
    "shader",
    "shader-nodes",
    "vite",
    "vite-plugin",
    "plugin",
    "operators",
    "operator-overloading",
    "transform",
    "babel"
  ],
  "repository": "github:makio64/vite-plugin-tsl-operator",
  "author": "David Ronai | Makio64",
  "license": "MIT",
  "dependencies": {
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0"
  },
  "devDependencies": {
    "@vitest/browser": "^4.1.4",
    "@vitest/browser-playwright": "^4.1.4",
    "playwright": "^1.59.1",
    "three": "^0.184.0",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@10.33.0"
}
